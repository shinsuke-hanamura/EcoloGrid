# 本番/常駐用サーバイメージ
# 注意: Docker 20.10 は古く、bookworm(glibc>=2.34) の clone3 を seccomp が拒否してスレッドが作れない。bullseye を使う
FROM python:3.12-slim-bullseye
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY server/ecologrid ./ecologrid
RUN useradd -m app
USER app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s CMD python -c "import urllib.request as u;u.urlopen('http://127.0.0.1:8000/api/v1/healthz',timeout=2)"
# ワールドは単一プロセスのメモリ上にあるため workers は 1 固定
CMD ["uvicorn", "ecologrid.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
